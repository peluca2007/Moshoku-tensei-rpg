{
  "permissions": {
    "allow": [
      "PowerShell(npm *)",
      "PowerShell(npx tsc --noEmit 2>&1 | Out-String -Width 200)",
      "PowerShell(Start-Sleep -Seconds 3; Invoke-WebRequest -Uri http://localhost:3000 -UseBasicParsing | Select-Object -ExpandProperty StatusCode)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
