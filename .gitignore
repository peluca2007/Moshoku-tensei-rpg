# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PDFs derivados: a ficha é montada em Typst em tempo de execução (typstFicha.ts)
# e baixada pelo botão "Baixar PDF" — não faz sentido versionar um binário que
# muda a cada exportação.
*.pdf

# LaTeX: removido do projeto em 2026-09-03. O livro vive em src/components/book/
# e é lido em /livro; não há mais pipeline .tex.
*.tex
*.cls
/livro-tex/

# rascunho antigo do livro (Homebrewery/Markdown)
livro em txt.txt

# claude code - estado local de ferramenta, nunca versionado
.claude/settings.local.json
/.claude/worktrees/
/.claude/scheduled_tasks.lock

# backup de um .git corrompido, restaurado em 2026-08-31 — 13 objetos soltos que
# entraram no repositório por acidente. Não é histórico: o histórico real está no
# .git de verdade. Pode ser apagado do disco com segurança (rm -rf).
/.git.corrupted-backup/

# Imagens avaliadas e recusadas para o design (ver PATCH_NOTES 0.1.5) — ficam
# fora de public/ pra nao serem servidas, e fora do git pra nao pesarem no repo.
.recusadas/

# Originais das faixas: o arquivo grande de onde a faixa de public/ foi recortada
# (loja: 3840px, 4,4 MB). Mesma regra do .recusadas/ — fora de public/ pra não ser
# servido, fora do git pra não pesar no repo, mas guardado em disco pra permitir
# recortar de novo sem procurar a imagem outra vez.
/assets-fonte/originais/
